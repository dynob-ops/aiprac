Q1) Write a program to demonstrate the Hill Climbing Algorithm for 
finding the maximum value of a simple objective function.

def objective(x):
    return -x**2+6*x

def hill_climbing(start):
    current=start

    while True:
        neighbour1=current+1
        neighbour2=current-1
        
        if objective(neighbour1)>objective(current):
            current=neighbour1
            
        elif objective(neighbour2)>objective(current):
            current=neighbour2
        else: 
            break

    return current, objective(current)

x,value=hill_climbing(0)

print("max value of x",x)
print("max objective value",value)

Q2) Write a program or report to compare Supervised Learning and 
Unsupervised Learning techniques. 

from sklearn.cluster import KMeans
from sklearn.linear_model import LogisticRegression

X=[[2,40],[3,45],[8,85],[9,90]]
Y=[0,0,1,1]

supervise_model=LogisticRegression()
supervise_model.fit(X,Y)

print("supervise model :",supervise_model.predict([[7,80]]))

unsupervise_model=KMeans(n_clusters=2,random_state=0)
unsupervise_model.fit(X)

print("unsupervise clusters :",unsupervise_model.labels_)
